[Unit]
Description=Short Video Crawler API
After=network.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -m app.cli.main serve --host 0.0.0.0 --port 8080
StandardOutput=append:__APP_DIR__/crawler.log
StandardError=append:__APP_DIR__/crawler.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
